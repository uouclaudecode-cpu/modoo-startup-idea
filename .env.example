# Supabase 대시보드 → Project Settings → API Keys 에서 복사하세요.
# 이 파일을 복사해 .env.local 로 이름을 바꾸고 값을 채웁니다. (.env.local 은 Git에 올라가지 않아요)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# 선택: 서비스 이름, QR에 넣을 사이트 주소(배포 주소). 비워 두면 현재 접속 주소를 씁니다.
NEXT_PUBLIC_SITE_NAME=B-LOCK
NEXT_PUBLIC_SITE_URL=

# 네이버 클라우드 플랫폼 > Maps > Application의 Client ID (Dynamic Map, 웹 서비스 URL 등록 필요)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 웹 푸시 알림(VAPID) 키: `npx web-push generate-vapid-keys --json` 으로 한 번 만들어 넣어요.
# 공개 키는 브라우저에 보여도 되고, 비공개 키는 서버에만 둡니다 (Vercel 환경변수).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 데이터베이스가 /api/push 를 부를 때 쓰는 비밀값. supabase/008_push.sql 실행 뒤
#   select secret from app_private.push_config;  결과를 그대로 넣어요.
PUSH_WEBHOOK_SECRET=
